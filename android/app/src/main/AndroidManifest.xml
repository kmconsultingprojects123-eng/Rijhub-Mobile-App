<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.rijhub.app">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    
    <!-- Awesome Notifications Permissions -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/> -->

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Camera + storage for the Dojah KYC WebView SDK (selfie + liveness).
         Without CAMERA declared, permission_handler returns "denied"
         immediately and the SDK's permission-request loop spins forever
         on a placeholder spinner. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/> -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <!-- Unused by this app, and each makes Google Play ask for a declaration
         (a video, for foreground services): exact alarms and the old
         voice-call screen's foreground services, plugins' copies included
         (2026-10-23). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" tools:node="remove"/>

    <!-- Reading Employi's messages aloud: lets the app find the phone's
         speech engine (Android 11 and later). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/NormalTheme">

        <!-- Default notification channel for FCM (Android 8+) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- Push notifications: the white Employi pin in the status bar, tinted crimson -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_employi" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_crimson" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAjdDayJe-TVV8Cz6a-kHFCoJm6oNgeix8" />

        <!--
          Google OAuth: add your Web client ID here (optional helper metadata).
          Replace the value with your web client ID (e.g. 12345-abc.apps.googleusercontent.com)
          The google_sign_in plugin usually handles required config, but placing the
          web client id here can help for some flows.
        -->
        <meta-data
            android:name="com.google.android.gms.client_id"
            android:value="REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com" />

        <!-- Flutter's standard activity (2026-10-23). It had lost them:
             singleTop, so tapping a notification returns to the running app
             instead of starting a second copy on top; configChanges, so
             turning the phone or switching dark mode doesn't restart the app;
             adjustResize, so the keyboard pushes fields up; LaunchTheme for
             the splash. Gone with them, from the old voice-call screen:
             android:showOnLockScreen="true" and android:turnScreenOn="true". -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label=""
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- The theme behind the Flutter UI once it has started. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>



        <!-- Foreground service for AI voice support call persistence (commented out while feature is disabled)
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        -->

        <!-- awesome_notifications only shows banners here; its phone-call
             foreground service would need a Play declaration. -->
        <service
            android:name="me.carda.awesome_notifications.core.services.ForegroundService"
            tools:node="remove" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          Google ML Kit dependency hint. The Dojah KYC SDK uses ML Kit's
          face-detection model for liveness checks. Declaring "face" here
          tells Google Play Services to download the model when the app is
          installed (instead of on first use), so the first verification
          attempt doesn't fail with "Internal error has occurred when
          executing ML Kit tasks". Multiple models can be comma-separated.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />

    </application>
</manifest>
