<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.rijhub.app">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    
    <!-- Awesome Notifications Permissions -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Camera + storage for the Dojah KYC WebView SDK (selfie + liveness).
         Without CAMERA declared, permission_handler returns "denied"
         immediately and the SDK's permission-request loop spins forever
         on a placeholder spinner. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/NormalTheme">

        <!-- Default notification channel for FCM (Android 8+) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyAjdDayJe-TVV8Cz6a-kHFCoJm6oNgeix8" />

        <!--
          Google OAuth: add your Web client ID here (optional helper metadata).
          Replace the value with your web client ID (e.g. 12345-abc.apps.googleusercontent.com)
          The google_sign_in plugin usually handles required config, but placing the
          web client id here can help for some flows.
        -->
        <meta-data
            android:name="com.google.android.gms.client_id"
            android:value="REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label=""
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>



        <!-- Foreground service for AI voice support call persistence (commented out while feature is disabled)
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
        -->

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!--
          Google ML Kit dependency hint. The Dojah KYC SDK uses ML Kit's
          face-detection model for liveness checks. Declaring "face" here
          tells Google Play Services to download the model when the app is
          installed (instead of on first use), so the first verification
          attempt doesn't fail with "Internal error has occurred when
          executing ML Kit tasks". Multiple models can be comma-separated.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="face" />

    </application>
</manifest>
